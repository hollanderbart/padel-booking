KNLTB_EMAIL=jouw@email.nl
KNLTB_PASSWORD=jouwwachtwoord

# Naam van je telefoon in HA: Settings -> Devices & Services -> Mobile App
# Gebruik de suffix van de notify service, bijv. als de service
# 'notify.mobile_app_mijn_telefoon' heet, vul dan 'mijn_telefoon' in.
HA_NOTIFY_DEVICE_ID=mijn_telefoon
